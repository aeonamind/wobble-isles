{
  "name": "wobble-isles",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "loadtest": "tsx tools/loadtest.ts",
    "app:dev": "tauri dev",
    "app:build": "node tools/app-build.mjs",
    "tauri": "tauri",
    "version": "node tools/sync-version.mjs"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "colyseus": "^0.18.12",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "three": "^0.181.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@tauri-apps/cli": "^2.12.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/three": "^0.181.0",
    "concurrently": "^10.0.7",
    "lil-gui": "^0.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
