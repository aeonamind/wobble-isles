{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wobble Isles",
  "version": "../package.json",
  "identifier": "io.github.aeonamind.wobbleisles",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wobble Isles",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "backgroundColor": "#FFB3D9",
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A jelly party royale in the sky",
    "longDescription": "Tumble through short, chaotic rounds with your friends across a carnival of floating sky islands.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MzY0MkM4NjNBQkYyQkQKUldTOThxdGp5RUkyeFhqRlNYMno4UWN0OFFlczArd2JjM3FGdjZITHBsNzYvODZvWVc1V3h4ZU8K",
      "endpoints": [
        "https://github.com/aeonamind/wobble-isles/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
